#!/usr/bin/env bash
# Managed by HAO
# Service: site
# HAO-SITE: @@SITE_ID@@
# 目标路径: /usr/local/bin/@@SITE_ID@@-update （权限 0755）
#
# static 站点更新脚本：拉取最新代码 -> 构建 -> 发布 -> 重载 Nginx。
# 脚本内嵌所有解析后的字面量，不依赖 HAO skill 或本仓库，可独立运行。
#
# 生成时的注意事项：
#   - @@BUILD_CMD@@ 若为空，构建步骤自动跳过。
#   - 值里若含单引号，必须写成 '\'' 转义形式，否则生成的脚本语法错误。
#   - @@OUTPUT_DIR@@ 为 "." 时会发布仓库根目录，并自动排除 .git。
#   - @@DOCROOT@@ = /var/www/<域名>，无域名时 /var/www/<站点ID>。
set -euo pipefail

SITE_ID='@@SITE_ID@@'
CLONE_DIR='/opt/@@SITE_ID@@'
BRANCH='@@BRANCH@@'
TARGET_USER='@@TARGET_USER@@'
TARGET_GROUP='@@TARGET_GROUP@@'
TARGET_HOME='@@TARGET_HOME@@'
BUILD_CMD='@@BUILD_CMD@@'
OUTPUT_DIR='@@OUTPUT_DIR@@'
WEB_DIR='@@DOCROOT@@'

log() { printf '[%s-update] %s\n' "$SITE_ID" "$*"; }

if [ "${EUID:-$(id -u)}" -ne 0 ]; then
    echo "[ERROR] 请使用 root 权限运行: sudo $SITE_ID-update" >&2
    exit 1
fi

command -v git >/dev/null 2>&1 || { echo "[ERROR] 未找到 git 命令。" >&2; exit 1; }

run_as_target() {
    if [ "$TARGET_USER" = "$(id -un)" ]; then
        env HOME="$TARGET_HOME" "$@"
    else
        runuser -u "$TARGET_USER" -- env HOME="$TARGET_HOME" "$@"
    fi
}

log "拉取最新代码（分支 $BRANCH）..."
run_as_target git -C "$CLONE_DIR" fetch --prune origin
run_as_target git -C "$CLONE_DIR" checkout -f -B "$BRANCH" "origin/$BRANCH"
run_as_target git -C "$CLONE_DIR" reset --hard "origin/$BRANCH"

if [ -n "$BUILD_CMD" ]; then
    log "执行构建: $BUILD_CMD"
    run_as_target env CI=true bash -c "cd $CLONE_DIR && $BUILD_CMD"
fi

log "发布静态文件到 $WEB_DIR ..."
install -d -m 0755 "$WEB_DIR"
find "$WEB_DIR" -mindepth 1 -delete
cp -a "$CLONE_DIR/$OUTPUT_DIR/." "$WEB_DIR/"
if [ "$OUTPUT_DIR" = "." ]; then
    rm -rf "$WEB_DIR/.git"
fi
chown -R "$TARGET_USER:$TARGET_GROUP" "$WEB_DIR"
chmod 755 "$WEB_DIR"

log "重载 Nginx ..."
if ! systemctl reload nginx 2>/dev/null; then
    log "Nginx 未在运行或重载失败，已跳过（配置将在 Nginx 下次启动时生效）"
fi
log "完成。"
