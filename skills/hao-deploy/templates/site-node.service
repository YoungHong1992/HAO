# Managed by HAO
# Service: site
# HAO-SITE: @@SITE_ID@@
# 目标路径: /etc/systemd/system/@@SITE_ID@@.service
# 权限必须是 0640：@@EXTRA_ENV@@ 可能带敏感值，不能让普通用户读到。
# systemd 以 root 运行，0640 不影响它读取。
# 写入后: systemctl daemon-reload && systemctl enable --now @@SITE_ID@@.service
#
# ⚠️ 单元名不带前缀（业内通行命名），所以写入前**必须**先跑
#     hao-guard.sh unit-free @@SITE_ID@@
# 非 free、也不是本站点自己的，一律停下 —— /etc/systemd/system/<name>.service
# 会静默覆盖 /usr/lib/systemd/system/ 下的同名单元。
#
# @@NODE_BIN@@ 必须是 /usr/bin/node。落在 /home 下的 node（nvm、各类
# 版本管理器）对 systemd 不可见，也可能随用户目录被清理而消失 ——
# 见 references/node.md 开头记录的那次事故。
#
# @@EXTRA_ENV@@ 是可选的额外环境变量，每行一条 Environment="KEY=VALUE"，
# 放在 PORT 之后，因此同名时用户值覆盖默认值。不要在这里设 PORT。
#
# 占位符（**七个全都要替换**；写入后必须 `grep -n '@@[A-Z]' <目标文件>` 确认为空）:
#   @@SITE_ID@@     站点 ID，同时是单元名和 /opt 下的目录名，也是归属标记
#   @@TARGET_USER@@ 运行用户（不是 $USER —— 那个变量在 root shell 里恒为 root，
#                   见 references/site.md 第 0 节）
#   @@TARGET_HOME@@ 该用户的 home，给 HOME 环境变量用
#   @@NODE_BIN@@    必须是 /usr/bin/node
#   @@START_FILE@@  入口文件，默认 server.js
#   @@PORT@@        监听端口，必须和 nginx 内容块里的 @@PORT@@ 一致
#   @@EXTRA_ENV@@   额外环境变量；没有就整行删掉（留空行也行，但别留占位符）
[Unit]
Description=@@SITE_ID@@ (Node.js application, deployed by HAO)
After=network.target

[Service]
Type=simple
User=@@TARGET_USER@@
WorkingDirectory=/opt/@@SITE_ID@@
ExecStart=@@NODE_BIN@@ @@START_FILE@@ @@PORT@@
Restart=always
RestartSec=10s

Environment="NODE_ENV=production"
Environment="HOME=@@TARGET_HOME@@"
Environment="PORT=@@PORT@@"
@@EXTRA_ENV@@

NoNewPrivileges=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
