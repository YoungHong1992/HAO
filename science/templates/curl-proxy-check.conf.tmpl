# Managed by HAO
# Service: xray-httpsproxy
# 目标路径: 临时文件（0600），验证完就删，不会留在主机上
#
# 用途：验证代理真的能用时，口令必须交给 curl，但不能进命令行参数
# （/proc/<pid>/cmdline 同机可读）。所以走 curl 的配置文件：
#   curl -K <这个文件> https://api.ipify.org
#
# 占位符：@@DOMAIN@@ @@PORT@@ 由脚本注入，@@PROXY_USER@@ @@PROXY_PASSWORD@@
# 由 hao-secret.sh render 注入（值不经过 stdout）。
proxy = "https://@@DOMAIN@@:@@PORT@@"
proxy-user = "@@PROXY_USER@@:@@PROXY_PASSWORD@@"
silent
show-error
max-time = 20
