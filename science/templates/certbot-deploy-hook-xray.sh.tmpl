#!/bin/sh
# Managed by HAO
# Service: xray-httpsproxy
# 目标路径: /etc/letsencrypt/renewal-hooks/deploy/restart-xray.sh  (0755)
#
# 逐字安装，无占位符。
#
# 放在 renewal-hooks/deploy/ 而不是用 --deploy-hook：这是任何运维都能找到的位置，
# 而且对所有证书生效，不用在每个域名的签发命令里重复一遍。
#
# 严格说 xray 不重启也能拿到新证书（tlsSettings 的 oneTimeLoading 默认 false，
# 它会周期性重读证书文件）。但那依赖一个默认值，而证书悄悄过期的代价是代理直接不可用、
# 且用户看到的只是「连不上」。重启一次约 1 秒断流、60 天一次，换确定性很划算。
set -e

# 没装 xray 就静默退出：这个 hook 对所有证书生效，别的域名续期时不该报错。
[ -x /usr/local/bin/xray ] || exit 0
systemctl is-enabled xray >/dev/null 2>&1 || exit 0

# 先测配置。证书文件坏了（例如续期只写了半个文件）就不要重启 ——
# 让旧进程带着旧证书继续跑，比重启成一个起不来的服务好。
if /usr/local/bin/xray run -test -confdir /usr/local/etc/xray/conf.d >/dev/null 2>&1; then
    systemctl restart xray
else
    echo "restart-xray.sh: xray 配置测试未通过，跳过重启（保留正在运行的实例）" >&2
    exit 1
fi
