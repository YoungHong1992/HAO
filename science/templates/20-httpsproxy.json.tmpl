// Managed by HAO
// Service: xray-httpsproxy
// 目标路径: /usr/local/etc/xray/conf.d/20-httpsproxy.json  (0600)
//
// 这个文件含代理口令，权限 0600。**不要 cat 它，也不要贴进对话。**
// 客户端要的参数在 /etc/hao/xray-httpsproxy.client.txt（同样 0600）。
//
// 这就是「https 域名 端口 用户名 口令」那种代理：http 正向代理入站 + TLS + Basic 认证。
// 占位符：@@PORT@@ @@DOMAIN@@ @@CERT_FULLCHAIN@@ @@CERT_KEY@@ 由脚本 sed 注入（非密钥），
//         @@PROXY_USER@@ @@PROXY_PASSWORD@@ 由 hao-secret.sh render 注入（密钥）。
{
  "inbounds": [
    {
      "tag": "httpsproxy-in",
      "listen": "0.0.0.0",
      "port": @@PORT@@,
      "protocol": "http",
      "settings": {
        // 字段名是 accounts，**不是** users。上游文档那一页写的是 users，那是错的：
        // 源码 infra/conf/http.go 的 HTTPServerConfig 只认 `accounts`。
        // 写成 users 不会报错，会静默得到一个**没有认证的开放代理** —— 端口一开，
        // 扫描器几小时内就会找到它，然后这台机器变成别人的跳板。
        // 改这个文件之前先确认这一点。
        "accounts": [
          {
            "user": "@@PROXY_USER@@",
            "pass": "@@PROXY_PASSWORD@@"
          }
        ],
        // false = 只处理代理请求（CONNECT / 绝对 URI），不接管发到本端口的普通
        // HTTP 请求。设成 true 容易做出无限自环。
        "allowTransparent": false
      },
      "streamSettings": {
        "network": "tcp",
        "security": "tls",
        "tlsSettings": {
          "serverName": "@@DOMAIN@@",
          // 只谈 http/1.1：代理的 CONNECT 语义走 HTTP/1.1。让客户端谈成 h2
          // 会得到「TLS 握手成功但代理不工作」这种最难查的故障。
          "alpn": ["http/1.1"],
          "minVersion": "1.2",
          "certificates": [
            {
              // 直接指向 certbot 的 live 目录。oneTimeLoading 默认 false，
              // xray 会周期性重读这两个文件，所以续期后不重启也能拿到新证书；
              // deploy hook 里的重启是确定性兜底。
              "certificateFile": "@@CERT_FULLCHAIN@@",
              "keyFile": "@@CERT_KEY@@"
            }
          ]
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls"],
        "routeOnly": true
      }
    }
  ]
}
